# =============================================================================
# MusicForge / TabForge — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# --- Supabase (required for auth, cloud sync, AI proxy) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Stripe (required for billing) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: override auto-detected Supabase function URLs
# VITE_STRIPE_CHECKOUT_ENDPOINT=https://your-project.supabase.co/functions/v1/create-checkout-session
# VITE_STRIPE_PORTAL_ENDPOINT=https://your-project.supabase.co/functions/v1/create-portal-session

# --- AI Generation ---
# Optional: override auto-detected Supabase function URL
# VITE_RUN_GENERATION_ENDPOINT=https://your-project.supabase.co/functions/v1/run-generation

# --- Public API ---
# Optional: override auto-detected endpoint for API-key–based generation
# VITE_PUBLIC_API_GENERATE_ENDPOINT=https://your-project.supabase.co/functions/v1/api-generate

# --- App Origin (required for production Stripe redirects) ---
VITE_APP_BASE_URL=http://localhost:5173

# --- Analytics (optional) ---
# Provider: "posthog" | "plausible" | leave blank for custom endpoint
# VITE_ANALYTICS_PROVIDER=posthog
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint.example.com/events
